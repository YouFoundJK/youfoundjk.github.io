<!-- Scrambler / Decipher Script with Adaptive Length-Based Timings -->
<script>
  function setupCrypticScrambler() {
    const el = document.getElementById('hero-cryptic-text');
    if (!el) return;

    const words = [
      'physicist',
      'developer',
      'system architect',
      'AI enthusiast',
      'FOSS enthusiast'
    ];
    const letters = 'ABCDEFGHJKLMNPQRSTUVWXYZ0123456789!@#$%^&*_+-=';
    let currentIdx = 0;
    let animId: number | null = null;
    let dwellTimeout: NodeJS.Timeout | number | null = null;

    function scrambleTo(targetWord: string) {
      if (animId) cancelAnimationFrame(animId);
      if (dwellTimeout) clearTimeout(dwellTimeout);

      let iteration = 0;
      const wordLen = targetWord.length;
      // Dynamically calculate scramble duration based on word length
      const totalScrambleDuration = Math.min(1600, Math.max(850, wordLen * 75));
      const stepInterval = 35; // ~28 fps updates
      const totalSteps = totalScrambleDuration / stepInterval;
      const stepIncrement = wordLen / totalSteps;
      let lastTime = performance.now();

      function frame(now: number) {
        if (now - lastTime >= stepInterval) {
          lastTime = now;
          let result = '';
          for (let i = 0; i < wordLen; i++) {
            if (i < Math.floor(iteration)) {
              result += targetWord[i];
            } else {
              result += letters[Math.floor(Math.random() * letters.length)];
            }
          }
          if (el) el.textContent = result;
          iteration += stepIncrement;
        }

        if (iteration < wordLen) {
          animId = requestAnimationFrame(frame);
        } else {
          // Guaranteed clean final string
          if (el) el.textContent = targetWord;
          // Dynamically scale dwell reading time based on word length
          const dwellTime = Math.min(3800, Math.max(2200, wordLen * 140));
          dwellTimeout = setTimeout(cycle, dwellTime);
        }
      }

      animId = requestAnimationFrame(frame);
    }

    function cycle() {
      currentIdx = (currentIdx + 1) % words.length;
      scrambleTo(words[currentIdx]);
    }

    // Initialize first cycle after initial hold
    dwellTimeout = setTimeout(cycle, 2400);

    window.addEventListener('beforeunload', () => {
      if (animId) cancelAnimationFrame(animId);
      if (dwellTimeout) clearTimeout(dwellTimeout);
    });
  }

  document.addEventListener('DOMContentLoaded', setupCrypticScrambler);
  document.addEventListener('astro:page-load', setupCrypticScrambler);
</script>
