---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, subtitle, abstract, category, date, thumbnail, links } = project.data;
const slug = project.slug;
---

<div 
  class="project-card group relative rounded-2xl bg-obsidian-900/85 border border-white/[0.08] hover:border-ember-500/40 p-5 transition-colors duration-300 hover:shadow-glow-card vanilla-3d-tilt flex flex-col justify-between"
  data-categories={JSON.stringify(category)}
>
  <div>
    <!-- Image Media Container -->
    <div class="relative w-full aspect-video rounded-xl overflow-hidden bg-obsidian-850 mb-5 border border-white/[0.06] shadow-lg shadow-black/50">
      <img 
        src={thumbnail} 
        alt={title} 
        loading="lazy"
        class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
      />
      <!-- Gradient overlay scrim for contrast -->
      <div class="absolute inset-0 bg-gradient-to-t from-obsidian-950 via-obsidian-950/30 to-transparent"></div>

      <!-- Date Badge floating above image -->
      {date && (
        <span class="absolute top-3 right-3 px-2.5 py-1 rounded-md text-[11px] font-mono font-medium bg-obsidian-950/85 backdrop-blur-md border border-white/[0.1] text-slate-200 shadow-md">
          {date}
        </span>
      )}
    </div>

    <!-- Category Pills -->
    <div class="flex flex-wrap gap-1.5 mb-3">
      {category.map((cat: string) => (
        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono bg-ember-500/10 text-ember-400 border border-ember-500/25">
          {cat}
        </span>
      ))}
    </div>

    <!-- Title & Subtitle -->
    <div>
      <h3 class="text-xl font-display font-bold text-white group-hover:text-ember-400 transition-colors leading-snug">
        <a href={`/projects/${slug}/`} class="hover:underline focus:outline-none">
          {title}
        </a>
      </h3>
      {subtitle && (
        <h4 class="mt-1 text-xs font-mono text-slate-400 leading-normal line-clamp-1">
          {subtitle}
        </h4>
      )}
    </div>

    <!-- Abstract Description -->
    <p class="mt-3 text-sm text-slate-400 leading-relaxed line-clamp-3 font-sans">
      {abstract}
    </p>
  </div>

  <!-- Action Links Toolbar (Inside the box) -->
  <div class="mt-6 pt-4 border-t border-white/[0.06] flex items-center justify-between gap-2 flex-wrap">
    <!-- Resource Buttons (PDF, Slides, Code) -->
    <div class="flex items-center gap-1.5">
      {links.pdf && (
        <a 
          href={links.pdf} 
          target="_blank" 
          rel="noopener noreferrer"
          class="px-2.5 py-1 text-xs font-mono rounded bg-white/[0.04] hover:bg-white/[0.1] text-slate-300 hover:text-white border border-white/[0.08] transition-colors"
          title="Download Publication PDF"
        >
          PDF
        </a>
      )}
      {links.slides && (
        <a 
          href={links.slides} 
          target="_blank" 
          rel="noopener noreferrer"
          class="px-2.5 py-1 text-xs font-mono rounded bg-white/[0.04] hover:bg-white/[0.1] text-slate-300 hover:text-white border border-white/[0.08] transition-colors"
          title="View Presentation Slides"
        >
          Slides
        </a>
      )}
      {links.code && (
        <a 
          href={links.code} 
          target="_blank" 
          rel="noopener noreferrer"
          class="px-2.5 py-1 text-xs font-mono rounded bg-white/[0.04] hover:bg-white/[0.1] text-slate-300 hover:text-white border border-white/[0.08] transition-colors"
          title="View Source Code"
        >
          Code
        </a>
      )}
    </div>

    <!-- Read Detail / Case Study Link -->
    <a 
      href={`/projects/${slug}/`}
      class="inline-flex items-center gap-1 text-xs font-mono text-ember-400 hover:text-ember-300 font-medium group/link"
    >
      <span>Details</span>
      <svg class="w-3.5 h-3.5 group-hover/link:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </a>
  </div>
</div>
