---
---

<section id="contact" class="py-24 px-4 sm:px-6 lg:px-8 relative border-t border-white/[0.04]">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <!-- Info & Links Column -->
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-ember-500/10 border border-ember-500/25 text-ember-400 font-mono text-xs uppercase tracking-widest mb-3">
          <span class="w-2 h-2 rounded-full bg-ember-500 animate-pulse"></span>
          <span>Contact /&gt;</span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-display font-extrabold text-white tracking-tight">
          Get In Touch
        </h2>
        <p class="mt-4 text-base text-slate-400 font-sans max-w-lg leading-relaxed">
          Whether you're interested in collaborative research in plasma physics, computational modeling, or have questions regarding my projects, feel free to reach out.
        </p>

        <div class="mt-10 space-y-6">
          <!-- Social Link Tiles -->
          <a 
            href="https://github.com/YouFoundJK" 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex items-center gap-4 p-4 rounded-xl bg-obsidian-900/60 border border-white/[0.06] hover:border-ember-500/40 transition-all duration-200 group"
          >
            <div class="w-10 h-10 rounded-lg bg-white/[0.05] flex items-center justify-center text-slate-300 group-hover:text-white">
              <svg class="w-5 h-5 fill-currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
              </svg>
            </div>
            <div>
              <span class="text-xs font-mono text-slate-500 block">GitHub</span>
              <span class="text-sm font-mono text-white group-hover:text-ember-400 transition-colors">github.com/YouFoundJK</span>
            </div>
          </a>

          <a 
            href="https://www.linkedin.com/in/youfoundjk/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex items-center gap-4 p-4 rounded-xl bg-obsidian-900/60 border border-white/[0.06] hover:border-ember-500/40 transition-all duration-200 group"
          >
            <div class="w-10 h-10 rounded-lg bg-white/[0.05] flex items-center justify-center text-slate-300 group-hover:text-white">
              <svg class="w-5 h-5 fill-currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </div>
            <div>
              <span class="text-xs font-mono text-slate-500 block">LinkedIn</span>
              <span class="text-sm font-mono text-white group-hover:text-ember-400 transition-colors">linkedin.com/in/youfoundjk</span>
            </div>
          </a>

          <a 
            href="https://www.instagram.com/thats_brilliantly_crazy/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex items-center gap-4 p-4 rounded-xl bg-obsidian-900/60 border border-white/[0.06] hover:border-ember-500/40 transition-all duration-200 group"
          >
            <div class="w-10 h-10 rounded-lg bg-white/[0.05] flex items-center justify-center text-slate-300 group-hover:text-white">
              <svg class="w-5 h-5 fill-currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </div>
            <div>
              <span class="text-xs font-mono text-slate-500 block">Instagram</span>
              <span class="text-sm font-mono text-white group-hover:text-ember-400 transition-colors">@thats_brilliantly_crazy</span>
            </div>
          </a>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="p-8 rounded-2xl bg-obsidian-900/60 border border-white/[0.06]">
        <h3 class="text-xl font-bold font-display text-white mb-2">Send a Message</h3>
        <p class="text-xs font-mono text-slate-400 mb-6">Direct dispatch to inbox</p>

        <form 
          id="contact-form"
          action="https://formspree.io/f/placeholder" 
          method="POST"
          class="space-y-4"
        >
          <div>
            <label for="name" class="block text-xs font-mono text-slate-400 mb-1.5">Name</label>
            <input 
              type="text" 
              name="name" 
              id="name" 
              required
              placeholder="Your name" 
              class="w-full px-4 py-3 rounded-xl bg-obsidian-850 border border-white/[0.08] focus:border-ember-500 focus:ring-1 focus:ring-ember-500 text-white placeholder-slate-600 text-base sm:text-sm font-sans transition-colors outline-none"
            />
          </div>

          <div>
            <label for="email" class="block text-xs font-mono text-slate-400 mb-1.5">Email</label>
            <input 
              type="email" 
              name="email" 
              id="email" 
              required
              placeholder="name@example.com" 
              class="w-full px-4 py-3 rounded-xl bg-obsidian-850 border border-white/[0.08] focus:border-ember-500 focus:ring-1 focus:ring-ember-500 text-white placeholder-slate-600 text-base sm:text-sm font-sans transition-colors outline-none"
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-mono text-slate-400 mb-1.5">Message</label>
            <textarea 
              name="message" 
              id="message" 
              rows="4" 
              required
              placeholder="How can we collaborate?" 
              class="w-full px-4 py-3 rounded-xl bg-obsidian-850 border border-white/[0.08] focus:border-ember-500 focus:ring-1 focus:ring-ember-500 text-white placeholder-slate-600 text-base sm:text-sm font-sans transition-colors outline-none resize-none"
            ></textarea>
          </div>

          <button 
            type="submit"
            class="w-full py-3.5 px-6 rounded-xl bg-ember-500 hover:bg-ember-600 text-white font-mono text-sm font-semibold shadow-glow-ember hover:shadow-lg transition-all duration-200"
          >
            Send Message /&gt;
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
