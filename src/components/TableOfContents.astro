---
import katex from 'katex';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  isMobile?: boolean;
}

const { headings, isMobile = false } = Astro.props;
const filteredHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);

function extractBalancedLatex(str: string): string {
  let depth = 0;
  let started = false;
  let endIdx = 0;

  for (let i = 0; i < str.length; i++) {
    if (str[i] === '{') {
      depth++;
      started = true;
    } else if (str[i] === '}') {
      depth--;
      if (depth === 0 && started) {
        endIdx = i + 1;
        let j = endIdx;
        while (j < str.length && (str[j] === '^' || str[j] === '_')) {
          j++;
          if (str[j] === '{') {
            let subDepth = 1;
            j++;
            while (j < str.length && subDepth > 0) {
              if (str[j] === '{') subDepth++;
              else if (str[j] === '}') subDepth--;
              j++;
            }
            endIdx = j;
          } else {
            j++;
            endIdx = j;
          }
        }
        break;
      }
    }
  }

  return endIdx > 0 ? str.slice(0, endIdx) : str;
}

function renderHeadingWithLatex(raw: string): string {
  if (!raw || (!raw.includes('\\') && !raw.includes('$'))) {
    return raw;
  }

  // Unescape Astro's ${ which was transformed from {
  const unescaped = raw.replace(/\$\{/g, '{');

  // Check for pattern: prefix ( [garbled] \something... [garbled] ) suffix
  const parenMatch = unescaped.match(/^([^(]*)\((.*)\)([^)]*)$/);
  if (parenMatch) {
    const prefix = parenMatch[1].trim();
    const inside = parenMatch[2].trim();
    const suffix = parenMatch[3].trim();

    const slashIdx = inside.indexOf('\\');
    if (slashIdx !== -1) {
      const latex = extractBalancedLatex(inside.slice(slashIdx));
      try {
        const mathHtml = katex.renderToString(latex, {
          throwOnError: false,
          displayMode: false,
        });
        return `${prefix} (${mathHtml})${suffix}`;
      } catch (e) {
        // Fallback
      }
    }
  }

  // Handle regular inline $math$ if present
  return unescaped.replace(/\$([^$]+)\$/g, (_, math) => {
    try {
      return katex.renderToString(math, {
        throwOnError: false,
        displayMode: false,
      });
    } catch {
      return math;
    }
  });
}
---

{filteredHeadings.length > 0 && (
  <nav 
    class={isMobile 
      ? "toc-container text-xs font-mono" 
      : "toc-container p-5 rounded-2xl bg-obsidian-900/90 border border-white/[0.08] backdrop-blur-xl shadow-xl sticky top-24 self-start max-h-[calc(100vh-8rem)] overflow-y-auto"
    } 
    aria-label="Table of contents"
  >
    {!isMobile && (
      <div class="flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-slate-300 mb-4 pb-2 border-b border-white/[0.08]">
        <svg class="w-4 h-4 text-ember-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path>
        </svg>
        <span>Outline / ToC</span>
      </div>
    )}

    <ul class="space-y-1.5 text-xs font-mono">
      {filteredHeadings.map(h => (
        <li class={h.depth === 3 ? 'pl-3' : ''}>
          <a 
            href={`#${h.slug}`}
            class="toc-link block text-slate-400 hover:text-ember-400 transition-all py-1 leading-snug rounded px-1.5 hover:bg-white/[0.03]"
            data-slug={h.slug}
          >
            {h.depth === 3 && <span class="text-slate-600 mr-1">↳</span>}
            <span set:html={renderHeadingWithLatex(h.text)} />
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  function setupTocScrollSpy() {
    const links = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    if (!links.length) return;

    // Auto-close mobile drawer on link click
    links.forEach(l => {
      l.addEventListener('click', () => {
        const parentDetails = l.closest('details');
        if (parentDetails) {
          parentDetails.removeAttribute('open');
        }
      });
    });

    const slugs = Array.from(links).map(l => l.getAttribute('data-slug')).filter(Boolean) as string[];
    const headingEls = slugs.map(slug => document.getElementById(slug)).filter(Boolean) as HTMLElement[];

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          links.forEach(l => {
            if (l.getAttribute('data-slug') === id) {
              l.classList.add('text-ember-400', 'font-bold', 'bg-white/[0.05]');
              l.classList.remove('text-slate-400');
            } else {
              l.classList.remove('text-ember-400', 'font-bold', 'bg-white/[0.05]');
              l.classList.add('text-slate-400');
            }
          });
        }
      });
    }, {
      rootMargin: '-80px 0px -70% 0px',
      threshold: 0
    });

    headingEls.forEach(el => observer.observe(el));
  }

  document.addEventListener('DOMContentLoaded', setupTocScrollSpy);
  document.addEventListener('astro:page-load', setupTocScrollSpy);
</script>
