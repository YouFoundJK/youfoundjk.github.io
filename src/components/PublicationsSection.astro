---
import { getCollection } from 'astro:content';

const allPubs = await getCollection('publications');
const sortedPubs = allPubs.sort((a, b) => a.data.order - b.data.order);

// Initial batch to show upfront (first 3)
const initialPubs = sortedPubs.slice(0, 3);
const remainingPubs = sortedPubs.slice(3);
---

<section id="publications" class="py-24 px-4 sm:px-6 lg:px-8 relative border-t border-white/[0.04]">
  <div class="max-w-7xl mx-auto">
    <!-- Section Header -->
    <div class="mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-ember-500/10 border border-ember-500/25 text-ember-400 font-mono text-xs uppercase tracking-widest mb-3">
        <span class="w-2 h-2 rounded-full bg-ember-500 animate-pulse"></span>
        <span>Publications /&gt;</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-display font-extrabold text-white tracking-tight">
        Peer-Reviewed Papers & Theses
      </h2>
      <p class="mt-2 text-base text-slate-400 font-sans max-w-xl">
        Published research articles in physics, biophysics, and nanotechnology from Charles University, KIT, and UM-DAE CEBS.
      </p>
    </div>

    <!-- Publications List with Gradient Fade -->
    <div class="relative">
      <!-- Initial Publications (Always visible) -->
      <div class="space-y-4">
        {initialPubs.map(pub => (
          <div class="group p-6 rounded-2xl bg-obsidian-900/70 border border-white/[0.06] hover:border-ember-500/40 transition-all duration-300 shadow-md flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="space-y-2 max-w-3xl">
              <div class="flex items-center gap-3 flex-wrap">
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono bg-ember-500/10 text-ember-400 border border-ember-500/25 font-semibold">
                  {pub.data.type}
                </span>
                <span class="text-xs font-mono text-slate-400">
                  {pub.data.journal} • {pub.data.year}
                </span>
              </div>

              <h3 class="text-lg font-bold font-display text-white group-hover:text-ember-400 transition-colors leading-snug">
                {pub.data.url ? (
                  <a href={pub.data.url} target="_blank" rel="noopener noreferrer" class="hover:underline">
                    {pub.data.title}
                  </a>
                ) : pub.data.title}
              </h3>

              <p class="text-xs font-mono text-slate-400">
                {pub.data.authors}
              </p>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center gap-2 shrink-0 flex-wrap">
              {pub.data.doi && (
                <a 
                  href={`https://doi.org/${pub.data.doi}`} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="px-3 py-1.5 rounded-lg text-xs font-mono bg-white/[0.04] hover:bg-white/[0.08] text-slate-200 border border-white/[0.1] hover:border-ember-500/40 transition-colors inline-flex items-center gap-1.5"
                >
                  <span>DOI</span>
                  <svg class="w-3.5 h-3.5 text-ember-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                  </svg>
                </a>
              )}

              {pub.data.pdf && (
                <a 
                  href={pub.data.pdf} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="px-3 py-1.5 rounded-lg text-xs font-mono bg-ember-500 hover:bg-ember-600 text-white font-semibold shadow-glow-ember transition-all inline-flex items-center gap-1.5"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                  </svg>
                  <span>PDF</span>
                </a>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- Expandable Row of Remaining Publications -->
      <div 
        id="more-pubs-container" 
        class="space-y-4 mt-4 transition-all duration-500 overflow-hidden"
        style="max-height: 0; opacity: 0;"
      >
        {remainingPubs.map(pub => (
          <div class="group p-6 rounded-2xl bg-obsidian-900/70 border border-white/[0.06] hover:border-ember-500/40 transition-all duration-300 shadow-md flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="space-y-2 max-w-3xl">
              <div class="flex items-center gap-3 flex-wrap">
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono bg-ember-500/10 text-ember-400 border border-ember-500/25 font-semibold">
                  {pub.data.type}
                </span>
                <span class="text-xs font-mono text-slate-400">
                  {pub.data.journal} • {pub.data.year}
                </span>
              </div>

              <h3 class="text-lg font-bold font-display text-white group-hover:text-ember-400 transition-colors leading-snug">
                {pub.data.url ? (
                  <a href={pub.data.url} target="_blank" rel="noopener noreferrer" class="hover:underline">
                    {pub.data.title}
                  </a>
                ) : pub.data.title}
              </h3>

              <p class="text-xs font-mono text-slate-400">
                {pub.data.authors}
              </p>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center gap-2 shrink-0 flex-wrap">
              {pub.data.doi && (
                <a 
                  href={`https://doi.org/${pub.data.doi}`} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="px-3 py-1.5 rounded-lg text-xs font-mono bg-white/[0.04] hover:bg-white/[0.08] text-slate-200 border border-white/[0.1] hover:border-ember-500/40 transition-colors inline-flex items-center gap-1.5"
                >
                  <span>DOI</span>
                  <svg class="w-3.5 h-3.5 text-ember-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                  </svg>
                </a>
              )}

              {pub.data.pdf && (
                <a 
                  href={pub.data.pdf} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="px-3 py-1.5 rounded-lg text-xs font-mono bg-ember-500 hover:bg-ember-600 text-white font-semibold shadow-glow-ember transition-all inline-flex items-center gap-1.5"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                  </svg>
                  <span>PDF</span>
                </a>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- Gradient Fade Overlay -->
      <div 
        id="pubs-fade-overlay" 
        class="absolute bottom-0 left-0 right-0 h-28 bg-gradient-to-t from-obsidian-950 via-obsidian-950/80 to-transparent pointer-events-none transition-opacity duration-300"
      ></div>
    </div>

    <!-- Standard More Button -->
    {remainingPubs.length > 0 && (
      <div class="mt-8 flex justify-center relative z-10">
        <button 
          id="toggle-pubs-btn"
          type="button"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-slate-200 border border-white/[0.1] font-mono text-xs font-semibold hover:border-ember-500/40 hover:text-white transition-all shadow-lg group"
        >
          <span id="toggle-pubs-text">+ Show More Publications ({remainingPubs.length} more)</span>
          <svg id="toggle-pubs-icon" class="w-4 h-4 text-ember-400 group-hover:translate-y-0.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
      </div>
    )}
  </div>
</section>

<script>
  function setupPubsToggle() {
    const btn = document.getElementById('toggle-pubs-btn');
    const container = document.getElementById('more-pubs-container');
    const overlay = document.getElementById('pubs-fade-overlay');
    const text = document.getElementById('toggle-pubs-text');
    const icon = document.getElementById('toggle-pubs-icon');

    if (!btn || !container) return;

    let isExpanded = false;

    btn.addEventListener('click', () => {
      isExpanded = !isExpanded;

      if (isExpanded) {
        container.style.maxHeight = '2000px';
        container.style.opacity = '1';
        if (overlay) overlay.style.opacity = '0';
        if (text) text.textContent = 'Show Less /&gt;';
        if (icon) icon.style.transform = 'rotate(180deg)';
      } else {
        container.style.maxHeight = '0px';
        container.style.opacity = '0';
        if (overlay) overlay.style.opacity = '1';
        if (text) text.textContent = `+ Show More Publications (3 more)`;
        if (icon) icon.style.transform = 'rotate(0deg)';

        const pubSection = document.getElementById('publications');
        pubSection?.scrollIntoView({ behavior: 'smooth' });
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupPubsToggle);
  document.addEventListener('astro:page-load', setupPubsToggle);
</script>
