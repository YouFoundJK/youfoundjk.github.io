---
import { getCollection } from 'astro:content';

const certs = await getCollection('certifications');
const sortedCerts = certs.sort((a, b) => a.data.order - b.data.order);

// Initial batch to show upfront (first 4 = 1 row on desktop)
const initialCerts = sortedCerts.slice(0, 4);
const remainingCerts = sortedCerts.slice(4);
---

<section id="certifications" class="py-24 px-4 sm:px-6 lg:px-8 relative border-t border-white/[0.04]">
  <div class="max-w-7xl mx-auto">
    <!-- Section Header -->
    <div class="mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-ember-500/10 border border-ember-500/25 text-ember-400 font-mono text-xs uppercase tracking-widest mb-3">
        <span class="w-2 h-2 rounded-full bg-ember-500 animate-pulse"></span>
        <span>Certifications /&gt;</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-display font-extrabold text-white tracking-tight">
        Certifications & Honors
      </h2>
      <p class="mt-2 text-base text-slate-400 font-sans max-w-xl">
        Specialized credentials in machine learning, mathematical physics, statistical mechanics, and quantitative analysis.
      </p>
    </div>

    <!-- Initial Row of Cards (Always visible, 100% uncovered) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {initialCerts.map(cert => (
        <div class="group flex flex-col justify-between rounded-2xl bg-obsidian-900/70 border border-white/[0.06] hover:border-ember-500/30 p-6 transition-all duration-300 hover:-translate-y-1 shadow-md">
          <div>
            <div class="flex items-center justify-between gap-3 mb-4">
              <span class="text-xs font-mono text-ember-400 font-medium">{cert.data.period}</span>
              {cert.data.logo && (
                <div class="w-7 h-7 rounded bg-white p-1 flex items-center justify-center shrink-0">
                  <img src={cert.data.logo} alt={cert.data.issuer} class="w-full h-full object-contain" />
                </div>
              )}
            </div>

            <h3 class="text-base font-bold text-white font-display group-hover:text-ember-400 transition-colors leading-snug">
              {cert.data.title}
            </h3>

            <p class="mt-1 text-xs font-mono text-slate-400">
              {cert.data.issuer}
            </p>

            <p class="mt-3 text-xs text-slate-400 font-sans leading-relaxed line-clamp-3">
              {cert.data.description}
            </p>
          </div>

          <div class="mt-6 pt-3 border-t border-white/[0.04] flex items-center justify-between">
            {cert.data.certificateUrl ? (
              <a 
                href={cert.data.certificateUrl} 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-mono text-ember-400 hover:text-ember-300 transition-colors"
              >
                <span>Verify Credential</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
              </a>
            ) : (
              <span class="text-[11px] font-mono text-slate-600">Verified Course</span>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Expandable Row of Remaining Certifications (Row 2 peeks underneath with shadow) -->
    {remainingCerts.length > 0 && (
      <div 
        id="more-certs-wrapper" 
        class="relative mt-6 group/peek cursor-pointer"
        title="Click to expand certifications"
      >
        <div 
          id="more-certs-container" 
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 overflow-hidden transition-[max-height] duration-700 ease-in-out"
          style="max-height: 110px;"
        >
          {remainingCerts.map(cert => (
            <div class="group flex flex-col justify-between rounded-2xl bg-obsidian-900/70 border border-white/[0.06] hover:border-ember-500/30 p-6 transition-all duration-300 hover:-translate-y-1 shadow-md">
              <div>
                <div class="flex items-center justify-between gap-3 mb-4">
                  <span class="text-xs font-mono text-ember-400 font-medium">{cert.data.period}</span>
                  {cert.data.logo && (
                    <div class="w-7 h-7 rounded bg-white p-1 flex items-center justify-center shrink-0">
                      <img src={cert.data.logo} alt={cert.data.issuer} class="w-full h-full object-contain" />
                    </div>
                  )}
                </div>

                <h3 class="text-base font-bold text-white font-display group-hover:text-ember-400 transition-colors leading-snug">
                  {cert.data.title}
                </h3>

                <p class="mt-1 text-xs font-mono text-slate-400">
                  {cert.data.issuer}
                </p>

                <p class="mt-3 text-xs text-slate-400 font-sans leading-relaxed line-clamp-3">
                  {cert.data.description}
                </p>
              </div>

              <div class="mt-6 pt-3 border-t border-white/[0.04] flex items-center justify-between">
                {cert.data.certificateUrl ? (
                  <a 
                    href={cert.data.certificateUrl} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-xs font-mono text-ember-400 hover:text-ember-300 transition-colors"
                  >
                    <span>Verify Credential</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                  </a>
                ) : (
                  <span class="text-[11px] font-mono text-slate-600">Verified Course</span>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- Gradient Fade Overlay (Positioned exclusively over Row 2!) -->
        <div 
          id="certs-fade-overlay" 
          class="absolute inset-0 bg-gradient-to-t from-obsidian-950 via-obsidian-950/80 via-60% to-transparent pointer-events-auto cursor-pointer transition-opacity duration-500"
        ></div>
      </div>
    )}

    <!-- Standard More Button -->
    {remainingCerts.length > 0 && (
      <div class="mt-6 flex justify-center relative z-10" id="toggle-certs-wrapper">
        <button 
          id="toggle-certs-btn"
          type="button"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-slate-200 border border-white/[0.1] font-mono text-xs font-semibold hover:border-ember-500/40 hover:text-white transition-all shadow-lg group active:scale-[0.98]"
        >
          <span id="toggle-certs-text">+ Show More Certifications ({remainingCerts.length} more)</span>
          <svg id="toggle-certs-icon" class="w-4 h-4 text-ember-400 group-hover:translate-y-0.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
      </div>
    )}
  </div>
</section>

<script>
  function setupCertsToggle() {
    const btn = document.getElementById('toggle-certs-btn');
    const container = document.getElementById('more-certs-container');
    const wrapper = document.getElementById('more-certs-wrapper');
    const overlay = document.getElementById('certs-fade-overlay');
    const text = document.getElementById('toggle-certs-text');
    const icon = document.getElementById('toggle-certs-icon');
    const toggleWrapper = document.getElementById('toggle-certs-wrapper');

    if (!btn || !container) return;

    const PEEK_HEIGHT = '110px';
    let isExpanded = false;

    function toggleExpanded(expand?: boolean) {
      if (!container) return;
      isExpanded = expand !== undefined ? expand : !isExpanded;

      if (isExpanded) {
        container.style.maxHeight = '2000px';
        if (wrapper) {
          wrapper.classList.remove('cursor-pointer');
          wrapper.removeAttribute('title');
        }
        if (overlay) {
          overlay.style.opacity = '0';
          overlay.classList.remove('pointer-events-auto', 'cursor-pointer');
          overlay.classList.add('pointer-events-none');
        }
        if (text) text.textContent = 'Show Less />';
        if (icon) icon.style.transform = 'rotate(180deg)';
        if (toggleWrapper) {
          toggleWrapper.classList.remove('mt-6');
          toggleWrapper.classList.add('mt-10');
        }
      } else {
        container.style.maxHeight = PEEK_HEIGHT;
        if (wrapper) {
          wrapper.classList.add('cursor-pointer');
          wrapper.setAttribute('title', 'Click to expand certifications');
        }
        if (overlay) {
          overlay.style.opacity = '1';
          overlay.classList.add('pointer-events-auto', 'cursor-pointer');
          overlay.classList.remove('pointer-events-none');
        }
        if (text) text.textContent = `+ Show More Certifications (${container.children.length} more)`;
        if (icon) icon.style.transform = 'rotate(0deg)';
        if (toggleWrapper) {
          toggleWrapper.classList.remove('mt-10');
          toggleWrapper.classList.add('mt-6');
        }

        // Smooth scroll back to certifications header
        const certSection = document.getElementById('certifications');
        certSection?.scrollIntoView({ behavior: 'smooth' });
      }
    }

    btn.addEventListener('click', () => toggleExpanded());
    if (overlay) {
      overlay.addEventListener('click', () => {
        if (!isExpanded) toggleExpanded(true);
      });
    }
  }

  document.addEventListener('DOMContentLoaded', setupCertsToggle);
  document.addEventListener('astro:page-load', setupCertsToggle);
</script>
