---
import { getCollection } from 'astro:content';
import TiltCard from './TiltCard.astro';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);
const remainingCount = Math.max(0, sortedProjects.length - 3);

// Extract distinct categories
const rawCategories = sortedProjects.flatMap(p => p.data.category);
const categories = ['All', ...Array.from(new Set(rawCategories))];
---

<section id="work" class="py-24 px-4 sm:px-6 lg:px-8 relative border-t border-white/[0.04]">
  <div class="max-w-7xl mx-auto">
    <!-- Section Header with Breadcrumb Node -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-12">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-ember-500/10 border border-ember-500/25 text-ember-400 font-mono text-xs uppercase tracking-widest mb-3">
          <span class="w-2 h-2 rounded-full bg-ember-500 animate-pulse"></span>
          <span>Work /&gt;</span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-display font-extrabold text-white tracking-tight">
          Research &amp; Projects
        </h2>
        <p class="mt-2 text-base text-slate-400 font-sans max-w-xl">
          Theoretical and computational studies in plasma physics, nanotechnology, condensed matter, and scientific software.
        </p>
      </div>

      <div class="text-xs font-mono text-slate-500">
        <span class="text-ember-400 font-bold">{sortedProjects.length}</span> projects documented
      </div>
    </div>

    <!-- Category Filter Bar -->
    <div class="mb-12 overflow-x-auto pb-2 scrollbar-none">
      <div class="flex items-center gap-2 min-w-max" id="project-filters">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-filter={cat}
            class={`filter-btn px-4 py-2 rounded-lg text-xs font-mono font-medium transition-all duration-200 border ${
              idx === 0 
                ? 'bg-ember-500 text-white border-ember-500 shadow-glow-ember' 
                : 'bg-white/[0.03] text-slate-400 border-white/[0.08] hover:text-white hover:bg-white/[0.06]'
            }`}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- 3D Parallax Tilt Cards Area: Single Unified Grid (Populates Rows First) -->
    <div 
      id="more-projects-wrapper" 
      class="relative group/peek cursor-pointer"
      title="Click to expand research & projects"
    >
      <!-- Single Unified Grid Container -->
      <div 
        id="more-projects-container" 
        class="overflow-hidden transition-[max-height] duration-700 ease-in-out"
        style="max-height: 720px;"
      >
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="projects-grid">
          {sortedProjects.map(project => (
            <TiltCard project={project} />
          ))}
        </div>
      </div>

      <!-- Gradient Fade Overlay (Positioned exclusively over the peeked second row) -->
      <div 
        id="projects-fade-overlay" 
        class="absolute inset-x-0 bg-gradient-to-t from-obsidian-950 via-obsidian-950/80 via-60% to-transparent pointer-events-auto cursor-pointer transition-opacity duration-500"
      ></div>
    </div>

    <!-- Standard More Button -->
    {remainingCount > 0 && (
      <div class="mt-6 flex justify-center relative z-10" id="toggle-projects-wrapper">
        <button 
          id="toggle-projects-btn"
          type="button"
          class="inline-flex items-center gap-2.5 px-7 py-3.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-slate-200 border border-white/[0.1] font-mono text-xs font-semibold hover:border-ember-500/40 hover:text-white transition-all shadow-lg group active:scale-[0.98]"
        >
          <span id="toggle-projects-text">+ Show More Research &amp; Projects ({remainingCount} more)</span>
          <svg id="toggle-projects-icon" class="w-4 h-4 text-ember-400 group-hover:translate-y-0.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
      </div>
    )}

    <!-- Empty State Fallback -->
    <div id="no-projects" class="hidden text-center py-16 text-slate-500 font-mono text-sm">
      No projects found under this category.
    </div>
  </div>
</section>

<!-- Filter & Show More Interactivity Script -->
<script>
  function setupWorkSection() {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.project-card');
    const noProjectsMsg = document.getElementById('no-projects');
    
    const toggleBtn = document.getElementById('toggle-projects-btn');
    const moreContainer = document.getElementById('more-projects-container');
    const moreWrapper = document.getElementById('more-projects-wrapper');
    const fadeOverlay = document.getElementById('projects-fade-overlay');
    const toggleText = document.getElementById('toggle-projects-text');
    const toggleIcon = document.getElementById('toggle-projects-icon');
    const toggleWrapper = document.getElementById('toggle-projects-wrapper');

    const PEEK_AMOUNT = 140;
    let isExpanded = false;
    let currentFilter = 'All';

    // Calculate dynamic peek so the shadow covers ONLY the second row and NEVER touches Row 1
    function updatePeekLayout() {
      if (isExpanded || currentFilter !== 'All') return;
      if (!moreContainer || !fadeOverlay || cards.length <= 3) return;

      const firstTop = cards[0].offsetTop;
      let row2Card: HTMLElement | null = null;
      for (let i = 0; i < cards.length; i++) {
        if (cards[i].offsetTop > firstTop + 10) {
          row2Card = cards[i];
          break;
        }
      }

      if (row2Card) {
        const row2Top = row2Card.offsetTop;
        const collapsedHeight = row2Top + PEEK_AMOUNT;
        moreContainer.style.maxHeight = `${collapsedHeight}px`;
        fadeOverlay.style.top = `${row2Top}px`;
        fadeOverlay.style.height = `${PEEK_AMOUNT}px`;
        fadeOverlay.style.bottom = 'auto';
      }
    }

    // 1. Show More / Less Toggle Function
    function toggleExpanded(expand?: boolean) {
      if (!moreContainer) return;
      isExpanded = expand !== undefined ? expand : !isExpanded;

      if (isExpanded) {
        moreContainer.style.overflow = 'hidden';
        moreContainer.style.maxHeight = '4000px';
        moreContainer.classList.remove('pointer-events-none', 'select-none');
        moreContainer.classList.add('pointer-events-auto');

        if (moreWrapper) {
          moreWrapper.classList.remove('cursor-pointer');
          moreWrapper.removeAttribute('title');
        }
        if (fadeOverlay) {
          fadeOverlay.style.opacity = '0';
          fadeOverlay.classList.remove('pointer-events-auto', 'cursor-pointer');
          fadeOverlay.classList.add('pointer-events-none');
        }
        if (toggleText) toggleText.textContent = 'Show Less />';
        if (toggleIcon) toggleIcon.style.transform = 'rotate(180deg)';
        if (toggleWrapper) {
          toggleWrapper.classList.remove('mt-6');
          toggleWrapper.classList.add('mt-10');
        }

        // Once transition completes, permit overflow for unrestricted 3D parallax depth
        setTimeout(() => {
          if (isExpanded && moreContainer) {
            moreContainer.style.overflow = 'visible';
          }
        }, 700);

        // Reinitialize VanillaTilt for newly expanded cards
        if (typeof (window as any).initTilts === 'function') {
          setTimeout(() => (window as any).initTilts(), 50);
        }
      } else {
        moreContainer.style.overflow = 'hidden';
        updatePeekLayout();
        moreContainer.classList.remove('pointer-events-none', 'select-none');
        moreContainer.classList.add('pointer-events-auto');

        if (moreWrapper) {
          moreWrapper.classList.add('cursor-pointer');
          moreWrapper.setAttribute('title', 'Click to expand research & projects');
        }
        if (fadeOverlay) {
          fadeOverlay.style.opacity = '1';
          fadeOverlay.classList.add('pointer-events-auto', 'cursor-pointer');
          fadeOverlay.classList.remove('pointer-events-none');
        }
        if (toggleText) toggleText.textContent = `+ Show More Research & Projects (${cards.length - 3} more)`;
        if (toggleIcon) toggleIcon.style.transform = 'rotate(0deg)';
        if (toggleWrapper) {
          toggleWrapper.classList.remove('mt-10');
          toggleWrapper.classList.add('mt-6');
        }

        // Scroll comfortably back to the top of the work section if user scrolled down
        const workSection = document.getElementById('work');
        if (workSection) {
          workSection.scrollIntoView({ behavior: 'smooth' });
        }
      }
    }

    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => toggleExpanded());
    }

    // Clicking the peek area while collapsed also expands the projects
    if (fadeOverlay) {
      fadeOverlay.addEventListener('click', () => {
        if (!isExpanded) {
          toggleExpanded(true);
        }
      });
    }

    // 2. Category Filter Bar
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        if (!filter) return;
        currentFilter = filter;

        // Update active button styling
        filterBtns.forEach(b => {
          b.classList.remove('bg-ember-500', 'text-white', 'border-ember-500', 'shadow-glow-ember');
          b.classList.add('bg-white/[0.03]', 'text-slate-400', 'border-white/[0.08]');
        });
        btn.classList.remove('bg-white/[0.03]', 'text-slate-400', 'border-white/[0.08]');
        btn.classList.add('bg-ember-500', 'text-white', 'border-ember-500', 'shadow-glow-ember');

        let matchCount = 0;

        if (filter === 'All') {
          // Reset to default collapse/expand behavior for 'All'
          if (toggleWrapper) toggleWrapper.style.display = 'flex';
          if (fadeOverlay) {
            fadeOverlay.style.display = 'block';
          }
          if (moreContainer) {
            moreContainer.style.overflow = isExpanded ? 'visible' : 'hidden';
            if (isExpanded) {
              moreContainer.style.maxHeight = '4000px';
            } else {
              updatePeekLayout();
            }
          }
          if (fadeOverlay) {
            fadeOverlay.style.opacity = isExpanded ? '0' : '1';
            if (isExpanded) {
              fadeOverlay.classList.add('pointer-events-none');
              fadeOverlay.classList.remove('pointer-events-auto', 'cursor-pointer');
            } else {
              fadeOverlay.classList.remove('pointer-events-none');
              fadeOverlay.classList.add('pointer-events-auto', 'cursor-pointer');
            }
          }

          cards.forEach(card => {
            card.style.display = 'flex';
            matchCount++;
          });
        } else {
          // When filtering by a specific topic, reveal all matching cards in unified grid
          if (toggleWrapper) toggleWrapper.style.display = 'none';
          if (fadeOverlay) {
            fadeOverlay.style.display = 'none';
            fadeOverlay.classList.add('pointer-events-none');
          }
          if (moreContainer) {
            moreContainer.style.overflow = 'visible';
            moreContainer.style.maxHeight = 'none';
          }
          if (moreWrapper) {
            moreWrapper.classList.remove('cursor-pointer');
          }

          cards.forEach(card => {
            const rawCategories = card.getAttribute('data-categories') || '[]';
            let cardCategories: string[] = [];
            try {
              cardCategories = JSON.parse(rawCategories);
            } catch (e) {
              cardCategories = [rawCategories];
            }

            if (cardCategories.includes(filter)) {
              card.style.display = 'flex';
              matchCount++;
            } else {
              card.style.display = 'none';
            }
          });
        }

        if (noProjectsMsg) {
          noProjectsMsg.classList.toggle('hidden', matchCount > 0);
        }

        // Ensure 3D tilts remain active
        if (typeof (window as any).initTilts === 'function') {
          setTimeout(() => (window as any).initTilts(), 50);
        }
      });
    });

    // Auto-calculate on resize and initial render
    window.addEventListener('resize', updatePeekLayout);
    setTimeout(updatePeekLayout, 50);
  }

  document.addEventListener('DOMContentLoaded', setupWorkSection);
  document.addEventListener('astro:page-load', setupWorkSection);
</script>
