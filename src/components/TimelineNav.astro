---
const sections = [
  { id: 'start', label: 'Start />' },
  { id: 'work', label: 'Work />' },
  { id: 'publications', label: 'Publications />' },
  { id: 'ventures', label: 'Ventures />' },
  { id: 'experience', label: 'Experience />' },
  { id: 'certifications', label: 'Certifications />' },
  { id: 'gallery', label: 'Gallery />' },
  { id: 'contact', label: 'Contact />' },
];
---

<aside 
  class="hidden lg:flex fixed left-4 xl:left-5 min-[1700px]:left-10 top-1/2 -translate-y-1/2 z-40 flex-col items-start pointer-events-none"
  aria-label="Section Navigation"
>
  <!-- Vertical Rail Line -->
  <div class="relative flex flex-col items-start gap-8 py-4 pointer-events-auto">
    <!-- Ambient glowing track background -->
    <div class="absolute left-[7px] top-0 bottom-0 w-[2px] bg-white/[0.08] -z-10"></div>
    <!-- Active track fill -->
    <div id="timeline-progress-bar" class="absolute left-[7px] top-0 w-[2px] bg-ember-500 transition-all duration-300 -z-10" style="height: 0%;"></div>

    {sections.map(section => (
      <a
        href={`#${section.id}`}
        data-target={section.id}
        class="timeline-node group relative flex items-center py-1 cursor-pointer select-none"
        aria-label={`Jump to ${section.label.replace(' />', '')} section`}
      >
        <!-- Node Pip Ring -->
        <span class="relative flex items-center justify-center w-4 h-4 rounded-full border-2 border-slate-600 bg-obsidian-950 group-hover:border-ember-400 group-hover:scale-125 transition-all duration-200 shrink-0">
          <span class="node-dot w-1.5 h-1.5 rounded-full bg-transparent group-hover:bg-ember-400 transition-colors"></span>
          <span class="node-ping absolute inset-0 rounded-full bg-ember-500 opacity-0 transition-opacity"></span>
        </span>
        <!-- Section Label (Floating pill on intermediate screens, inline on >=1700px) -->
        <span class="node-label">
          {section.label}
        </span>
      </a>
    ))}
  </div>
</aside>

<style>
  .timeline-node .node-label {
    position: absolute;
    left: 1.75rem;
    padding: 0.25rem 0.625rem;
    border-radius: 0.375rem;
    background-color: rgba(12, 15, 23, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(12px);
    white-space: nowrap;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: #94a3b8;
    opacity: 0;
    transform: translateX(-8px);
    pointer-events: none;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s, color 0.2s;
    z-index: 50;
  }

  .timeline-node:hover .node-label,
  .timeline-node:focus-visible .node-label {
    opacity: 1;
    transform: translateX(0);
    border-color: rgba(255, 112, 67, 0.5);
    color: #ff7043;
    pointer-events: auto;
  }

  .timeline-node.active .node-label {
    color: #ff7043;
    font-weight: 700;
  }

  /* On widescreen monitors (>= 1700px), labels stay permanently visible inline without tooltips */
  @media (min-width: 1700px) {
    .timeline-node {
      gap: 0.75rem;
    }

    .timeline-node .node-label {
      position: static;
      opacity: 1;
      transform: none;
      padding: 0;
      background-color: transparent;
      border: none;
      box-shadow: none;
      backdrop-filter: none;
      pointer-events: auto;
      color: #64748b;
    }

    .timeline-node:hover .node-label {
      color: #e2e8f0;
      border: none;
    }

    .timeline-node.active .node-label {
      color: #ff7043;
      border: none;
    }
  }
</style>

<script>
  function setupTimelineNav() {
    const nodes = document.querySelectorAll<HTMLAnchorElement>('.timeline-node');
    if (!nodes.length) return;

    const progressBar = document.getElementById('timeline-progress-bar');
    const sectionIds = Array.from(nodes).map(n => n.getAttribute('data-target')).filter(Boolean) as string[];
    const sectionEls = sectionIds.map(id => document.getElementById(id)).filter(Boolean) as HTMLElement[];

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const activeId = entry.target.id;
          let activeIndex = 0;

          nodes.forEach((node, index) => {
            const isMatch = node.getAttribute('data-target') === activeId;
            const ring = node.querySelector('span:first-child');
            const dot = node.querySelector('.node-dot');
            const label = node.querySelector('.node-label');
            const ping = node.querySelector('.node-ping');

            if (isMatch) {
              activeIndex = index;
              node.classList.add('active');
              ring?.classList.add('border-ember-500', 'shadow-glow-ember', 'scale-125');
              ring?.classList.remove('border-slate-600');
              dot?.classList.add('bg-ember-500');
              label?.classList.add('text-ember-400', 'font-bold');
              label?.classList.remove('text-slate-500');
              ping?.classList.add('animate-ping', 'opacity-75');
            } else {
              node.classList.remove('active');
              ring?.classList.remove('border-ember-500', 'shadow-glow-ember', 'scale-125');
              ring?.classList.add('border-slate-600');
              dot?.classList.remove('bg-ember-500');
              label?.classList.remove('text-ember-400', 'font-bold');
              label?.classList.add('text-slate-500');
              ping?.classList.remove('animate-ping', 'opacity-75');
            }
          });

          if (progressBar && nodes.length > 1) {
            const pct = (activeIndex / (nodes.length - 1)) * 100;
            progressBar.style.height = `${pct}%`;
          }
        }
      });
    }, {
      rootMargin: '-30% 0px -60% 0px',
      threshold: 0
    });

    sectionEls.forEach(el => observer.observe(el));
  }

  document.addEventListener('DOMContentLoaded', setupTimelineNav);
  document.addEventListener('astro:page-load', setupTimelineNav);
</script>
