---
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Jovi Koikkara | Physicist & Creative Developer",
  description = "Digital portfolio and research projects of Jovi Koikkara (YouFoundJK) — Int. M.Sc. Physics (UM-DAE CEBS), Mathematical Modelling, Plasma Physics, and Creative Technology.",
  image = "/images/avatar.png"
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString() : "https://youfoundjk.github.io";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Jovi Koikkara" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <link rel="icon" type="image/png" href="/images/avatar.png" />
    <meta name="theme-color" content="#07090e" />

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- KaTeX official CDN stylesheet & webfonts (ensures crisp glyphs and zero font metric mismatches) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous" />

    <!-- User Analytics (Umami Events) -->
    <script is:inline src="/scripts/analytics-events.js" defer></script>
  </head>
  <body class="bg-obsidian-950 text-slate-200 min-h-screen selection:bg-ember-500 selection:text-white relative">
    <!-- Ambient Atmospheric Glows -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 -left-40 w-[600px] h-[600px] bg-ember-600/10 rounded-full blur-[140px]"></div>
      <div class="absolute top-[35%] -right-40 w-[550px] h-[550px] bg-cyan-600/10 rounded-full blur-[150px]"></div>
      <div class="absolute bottom-20 left-1/3 w-[500px] h-[500px] bg-amber-600/5 rounded-full blur-[160px]"></div>
      <div class="absolute inset-0 bg-cyber-grid opacity-60"></div>
    </div>

    <!-- Main Content Shell -->
    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>

    <!-- VanillaTilt Script Integration (Enabled on desktop mouse/trackpads, smooth native scroll on touch) -->
    <script>
      import VanillaTilt from 'vanilla-tilt';

      function initTilts() {
        // Only initialize 3D tilt on devices with a fine pointer (mouse/trackpad)
        const isFinePointer = window.matchMedia('(pointer: fine)').matches;
        if (!isFinePointer) return;

        const tiltElements = document.querySelectorAll<HTMLElement>('.vanilla-3d-tilt');
        if (tiltElements.length > 0) {
          VanillaTilt.init(Array.from(tiltElements), {
            max: 16, // Responsive tilt so slight uncentering builds up parallax appropriately
            speed: 750,
            perspective: 1000,
            glare: true,
            'max-glare': 0.16,
            scale: 1.02, // Subtle 2% lift only during active hover; resets to 1.0 on leave
            reset: true, // Guarantees zero tilt and standard size when inactive
            gyroscope: false, // Prevents erratic shaking on mobile gyroscopes
          });
        }
      }

      // Expose globally so dynamically unfolded cards can initialize
      (window as any).initTilts = initTilts;

      // Run on DOM loaded and Astro view transitions
      document.addEventListener('DOMContentLoaded', initTilts);
      document.addEventListener('astro:page-load', initTilts);
    </script>
  </body>
</html>
