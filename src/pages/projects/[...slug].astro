---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const { title, subtitle, abstract, category, date, thumbnail, links } = project.data;
---

<Layout 
  title={`${title} | Jovi Koikkara`}
  description={abstract}
  image={thumbnail}
>
  <Header />

  <article class="min-h-screen py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
    <!-- Back Button -->
    <div class="mb-10">
      <a 
        href="/#work" 
        class="inline-flex items-center gap-2 text-xs font-mono text-slate-400 hover:text-ember-400 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        <span>Back to Projects /&gt;</span>
      </a>
    </div>

    <!-- Project Header -->
    <header class="mb-12 space-y-4">
      <div class="flex flex-wrap items-center gap-2">
        {category.map((cat: string) => (
          <span class="px-2.5 py-0.5 rounded-full text-xs font-mono bg-ember-500/10 text-ember-400 border border-ember-500/25">
            {cat}
          </span>
        ))}
        {date && (
          <span class="text-xs font-mono text-slate-500 ml-2">
            // {date}
          </span>
        )}
      </div>

      <h1 class="text-3xl sm:text-5xl font-display font-extrabold text-white leading-tight">
        {title}
      </h1>

      {subtitle && (
        <p class="text-lg font-mono text-slate-400">
          {subtitle}
        </p>
      )}

      <!-- Action Links Toolbar -->
      <div class="pt-4 flex flex-wrap items-center gap-3">
        {links.pdf && (
          <a 
            href={links.pdf} 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-ember-500 hover:bg-ember-600 text-white font-mono text-xs font-semibold shadow-glow-ember transition-all"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            <span>Download Paper (PDF)</span>
          </a>
        )}

        {links.slides && (
          <a 
            href={links.slides} 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white/[0.04] hover:bg-white/[0.08] text-slate-200 border border-white/[0.1] font-mono text-xs font-semibold transition-all"
          >
            <svg class="w-4 h-4 text-ember-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path>
            </svg>
            <span>Presentation Slides</span>
          </a>
        )}

        {links.code && (
          <a 
            href={links.code} 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white/[0.04] hover:bg-white/[0.08] text-slate-200 border border-white/[0.1] font-mono text-xs font-semibold transition-all"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
            </svg>
            <span>GitHub Repository</span>
          </a>
        )}
      </div>
    </header>

    <!-- Featured Image -->
    {thumbnail && (
      <div class="mb-12 rounded-2xl overflow-hidden border border-white/[0.08] shadow-2xl bg-obsidian-900">
        <img 
          src={thumbnail} 
          alt={title} 
          class="w-full max-h-[480px] object-contain bg-obsidian-950 p-4"
        />
      </div>
    )}

    <!-- Abstract Callout -->
    <div class="mb-12 p-6 rounded-xl bg-obsidian-900/60 border-l-4 border-ember-500 border border-white/[0.06]">
      <h3 class="text-xs font-mono uppercase tracking-widest text-ember-400 font-bold mb-2">Abstract</h3>
      <p class="text-slate-300 leading-relaxed font-sans text-sm sm:text-base">
        {abstract}
      </p>
    </div>

    <!-- Article Markdown Content -->
    <div class="prose prose-invert prose-slate max-w-none prose-headings:font-display prose-headings:text-white prose-a:text-ember-400 hover:prose-a:text-ember-300 prose-code:text-ember-300 prose-code:font-mono">
      <Content />
    </div>

    <!-- Bottom Navigation -->
    <div class="mt-16 pt-8 border-t border-white/[0.08] flex items-center justify-between">
      <a 
        href="/#work" 
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-white/[0.04] hover:bg-white/[0.08] text-slate-200 border border-white/[0.08] font-mono text-xs font-semibold transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        <span>All Projects</span>
      </a>

      {links.pdf && (
        <a 
          href={links.pdf} 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-ember-500 hover:bg-ember-600 text-white font-mono text-xs font-semibold shadow-glow-ember transition-all"
        >
          <span>Download PDF /&gt;</span>
        </a>
      )}
    </div>
  </article>

  <Footer />
</Layout>
