---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const allNotes = await getCollection('notes');
const sortedNotes = allNotes.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const allTags = Array.from(new Set(sortedNotes.flatMap(n => n.data.tags || [])));
---

<Layout 
  title="Technical Notes & Documentation | Jovi Koikkara"
  description="Obsidian-style mathematical notes, research derivations, and technical documentation."
>
  <Header />

  <main class="min-h-screen py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
    <!-- Header -->
    <div class="mb-14 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-ember-500/10 border border-ember-500/25 text-ember-400 font-mono text-xs uppercase tracking-widest">
        <span class="w-2 h-2 rounded-full bg-ember-500 animate-pulse"></span>
        <span>Knowledge Base /&gt;</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-display font-extrabold text-white tracking-tight">
        Technical Notes & Docs
      </h1>

      <p class="text-base sm:text-lg text-slate-400 max-w-2xl font-sans">
        Full-fledged Obsidian-compatible knowledge base supporting complete LaTeX math typesetting, Callouts, and derivations.
      </p>
    </div>

    <!-- Tags Filter -->
    {allTags.length > 0 && (
      <div class="mb-10 flex flex-wrap gap-2">
        <span class="text-xs font-mono text-slate-500 py-1 mr-2 flex items-center">Tags:</span>
        {allTags.map(tag => (
          <span class="px-3 py-1 rounded-md text-xs font-mono bg-white/[0.04] border border-white/[0.08] text-slate-300">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <!-- Notes Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedNotes.map(note => (
        <a 
          href={`/notes/${note.slug}/`}
          class="group block p-6 rounded-2xl bg-obsidian-900/70 border border-white/[0.08] hover:border-ember-500/40 hover:-translate-y-1 transition-all duration-300 shadow-md"
        >
          <div class="flex items-center justify-between gap-2 mb-3">
            <span class="text-xs font-mono text-ember-400 font-medium">
              {note.data.category}
            </span>
            {note.data.date && (
              <span class="text-xs font-mono text-slate-500">
                {note.data.date}
              </span>
            )}
          </div>

          <h2 class="text-xl font-bold font-display text-white group-hover:text-ember-400 transition-colors leading-snug">
            {note.data.title}
          </h2>

          {note.data.description && (
            <p class="mt-3 text-sm text-slate-400 font-sans leading-relaxed line-clamp-2">
              {note.data.description}
            </p>
          )}

          {note.data.tags && note.data.tags.length > 0 && (
            <div class="mt-4 pt-4 border-t border-white/[0.04] flex flex-wrap gap-1.5">
              {note.data.tags.map(t => (
                <span class="text-[11px] font-mono text-slate-500">
                  #{t}
                </span>
              ))}
            </div>
          )}
        </a>
      ))}
    </div>
  </main>

  <Footer />
</Layout>
