---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import TableOfContents from '@/components/TableOfContents.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { slug: note.slug },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content, headings } = await note.render();
const { title, description, category, tags, date, lastUpdated } = note.data;
---

<Layout 
  title={`${title} | Technical Notes`}
  description={description}
>
  <Header />

  <article class="min-h-screen py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <!-- Back to Notes Button -->
    <div class="mb-10">
      <a 
        href="/notes/" 
        class="inline-flex items-center gap-2 text-xs font-mono text-slate-400 hover:text-ember-400 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        <span>Back to All Notes /&gt;</span>
      </a>
    </div>

    <!-- Note Header -->
    <header class="mb-12 space-y-4 max-w-4xl">
      <div class="flex flex-wrap items-center gap-2">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono bg-ember-500/10 text-ember-400 border border-ember-500/25">
          {category}
        </span>
        {date && (
          <span class="text-xs font-mono text-slate-500 ml-2">
            Published: {date}
          </span>
        )}
        {lastUpdated && (
          <span class="text-xs font-mono text-slate-500 ml-2">
            • Last Updated: {lastUpdated}
          </span>
        )}
      </div>

      <h1 class="text-3xl sm:text-5xl font-display font-extrabold text-white leading-tight">
        {title}
      </h1>

      {description && (
        <p class="text-base sm:text-lg font-sans text-slate-400 leading-relaxed">
          {description}
        </p>
      )}

      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-2 pt-2">
          {tags.map((tag: string) => (
            <span class="text-xs font-mono text-slate-400 bg-white/[0.04] px-2.5 py-1 rounded border border-white/[0.06]">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Main Grid: Note Markdown + Table of Contents -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Document Content Column -->
      <div class="lg:col-span-8 xl:col-span-9 max-w-4xl">
        <div class="prose prose-invert prose-slate max-w-none prose-headings:font-display prose-headings:text-white prose-a:text-ember-400 hover:prose-a:text-ember-300 prose-code:text-ember-300 prose-code:font-mono">
          <Content />
        </div>

        <!-- Bottom Navigation -->
        <div class="mt-16 pt-8 border-t border-white/[0.08] flex items-center justify-between">
          <a 
            href="/notes/" 
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-white/[0.04] hover:bg-white/[0.08] text-slate-200 border border-white/[0.08] font-mono text-xs font-semibold transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>All Notes</span>
          </a>

          <a 
            href="/#contact" 
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-ember-500 hover:bg-ember-600 text-white font-mono text-xs font-semibold shadow-glow-ember transition-all"
          >
            <span>Discuss Derivation /&gt;</span>
          </a>
        </div>
      </div>

      <!-- Sticky Table of Contents Column -->
      <div class="hidden lg:block lg:col-span-4 xl:col-span-3">
        <TableOfContents headings={headings} />
      </div>
    </div>
  </article>

  <Footer />
</Layout>
